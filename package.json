{
  "name": "media-gecko",
  "version": "1.5.3",
  "private": true,
  "main": "electron.js",
  "description": "Fast local and online media library for video editors.",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mediagecko.desktop",
    "productName": "Media Gecko",
    "files": ["electron.js", "preload.js", "webview-preload.js", "server.js", "library-store.js", "public/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "tools", "to": "tools" }, { "from": "core-sfx", "to": "core-sfx" }],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "assets/gecko-main.png" },
    "nsis": {
      "artifactName": "Media-Gecko-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installer-gecko-sidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Media Gecko",
      "uninstallDisplayName": "Media Gecko"
    }
  }
}
